{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "outDir": "./.verify-build",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2020",
    "verbatimModuleSyntax": false
  },
  "include": ["src/data/**/*.ts", "src/api/**/*.ts", "verify/**/*.ts"]
}
